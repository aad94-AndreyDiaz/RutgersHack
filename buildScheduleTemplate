GROQ_API_KEY = "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"
URL = "https://api.groq.com/openai/v1/chat/completions"

def groq_call(payload, system_prompt):

    r = requests.post(
        URL,
        headers={
            "Authorization": f"Bearer {GROQ_API_KEY}",
            "Content-Type": "application/json"
        },
        json={
            "model": "llama-3.1-8b-instant",
            "messages": [
                {"role":"system","content":system_prompt},
                {"role":"user","content":json.dumps(payload)}
            ],
            "temperature":0.2
        }
    )

    return r.json()["choices"][0]["message"]["content"]

# =========================================================
# JSON SAFETY
# =========================================================
def extract_json(text):
    try:
        return json.loads(text)
    except:
        m = re.search(r"\{.*\}", text, re.DOTALL)
        if m:
            try:
                return json.loads(m.group())
            except:
                return None
    return None

# =========================================================
# MAIN OPTIMIZER (FIXED HYBRID LOGIC)
# =========================================================
def optimizer(data):

    burnout = burnout_engine(data)
    events = build_events()
    free_blocks = compute_free_blocks(events)

    system_prompt = """
You are a task allocator.

You do NOT create schedules from scratch.

You ONLY assign tasks into provided free time blocks.

Rules:
- Do NOT overlap blocks
- Do NOT modify calendar events
- Fill ONLY free blocks
- If burnout > 70 → reduce tasks (leave gaps)
- If burnout > 60 → insert 10 min breaks between tasks
- Prefer shorter tasks first if burnout high

Return JSON ONLY:

{
  "summary": "...",
  "schedule": [
    {
      "start": "HH:MM",
      "end": "HH:MM",
      "title": "...",
      "type": "task|break"
    }
  ]
}
"""

    payload = {
        "burnout": burnout,
        "tasks": data["tasks"],
        "free_blocks": free_blocks,
        "calendar": events
    }

    raw = groq_call(payload, system_prompt)
    plan = extract_json(raw)

    if not plan:
        plan = {"summary":"fallback","schedule":[]}

    state_memory["burnout_history"].append(burnout)

    return {
        "burnout": round(burnout,2),
        "free_blocks": free_blocks,
        "plan": plan
    }

