# =========================================================
# JSON PARSER SAFETY
# =========================================================
def extract_json(text):
    try:
        return json.loads(text)
    except Exception:
        m = re.search(r"\{.*\}", text, re.DOTALL)
        if m:
            try:
                return json.loads(m.group())
            except Exception:
                return None
    return None

# =========================================================
# SCHEDULER
# =========================================================
SYSTEM_PROMPT = """
You are a deterministic scheduling engine.

Return ONLY valid JSON — no markdown, no explanation.

Rules:
- Use ONLY provided free blocks
- Do NOT modify calendar events
- Fill free time with tasks or breaks
- If burnout > 70: reduce workload heavily, prioritise rest
- If burnout > 60: insert 10-15 min breaks between tasks
- No overlaps allowed

Output format:
{
  "schedule": [
    { "start": "HH:MM", "end": "HH:MM", "title": "string", "type": "task|break|idle" }
  ]
}
"""

def optimizer(data):
    burnout = burnout_engine(data)
    events = build_events()
    free_blocks = compute_free_blocks(events)

    payload = {
        "burnout": round(burnout, 2),
        "tasks": data["tasks"],
        "free_blocks": [
            {"start": to_time(s), "end": to_time(e)}
            for s, e in free_blocks
        ],
        "calendar": events
    }

    raw = groq_call(payload, SYSTEM_PROMPT)
    plan = extract_json(raw) or {"schedule": []}

    state_memory["burnout_history"].append(burnout)

    return {
        "burnout": round(burnout, 2),
        "free_blocks": free_blocks,
        "plan": plan
    }

# =========================================================
# ICS EXPORT
# =========================================================
def export_ics(schedule, filename="generated_schedule.ics"):
    now = datetime(2026, 4, 25, 6, 0, 0)

    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//CalmCore//BurnoutOptimizer//EN"
    ]

    for i, item in enumerate(schedule):
        try:
            sh, sm = map(int, item["start"].split(":"))
            eh, em = map(int, item["end"].split(":"))
            start_dt = now.replace(hour=sh, minute=sm)
            end_dt   = now.replace(hour=eh, minute=em)
            lines += [
                "BEGIN:VEVENT",
                f"UID:{i}@calmcore",
                f"DTSTART:{start_dt.strftime('%Y%m%dT%H%M%S')}",
                f"DTEND:{end_dt.strftime('%Y%m%dT%H%M%S')}",
                f"SUMMARY:{item.get('title', 'Task')}",
                "END:VEVENT"
            ]
        except Exception:
            continue

    lines.append("END:VCALENDAR")

    with open(filename, "w") as f:
        f.write("\n".join(lines))

    return filename

