    result = optimizer(data)
    return jsonify(result)

@app.route("/schedule", methods=["POST"])
def schedule():
    data = request.json
    result = optimizer(data)
    return jsonify(result["plan"])

@app.route("/export-ics", methods=["POST"])
def export_calendar():
    schedule_data = request.json["schedule"]
    file = export_ics(schedule_data)
    return send_file(file, as_attachment=True)

