def groq_call(payload, system_prompt):
    r = requests.post(
        URL,
        headers={
            "Authorization": f"Bearer {GROQ_API_KEY}",
            "Content-Type": "application/json"
        },
        json={
            "model": "llama-3.1-8b-instant",
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": json.dumps(payload)}
            ],
            "temperature": 0.2
        }
    )
    return r.json()["choices"][0]["message"]["content"]

# =========================================================
# JSON PARSER SAFETY
# =========================================================
def extract_json(text):
    try:
        return json.loads(text)
    except:
        m = re.search(r"\{.*\}", text, re.DOTALL)
        if m:
            try:
                return json.loads(m.group())
            except:
                return None
    return None

# =========================================================
# SCHEDULER (GROQ)
# =========================================================
def optimizer(data):

    burnout = burnout_engine(data)
    events = build_events()
    free_blocks = compute_free_blocks(events)

    system_prompt = """
You are a deterministic scheduling engine.

Return ONLY valid JSON.

Rules:
- Use ONLY provided free blocks
- Do NOT modify calendar events
- Fill free time with tasks or breaks
- If burnout > 70: reduce workload heavily
- If burnout > 60: insert 10–15 min breaks
- No overlaps allowed

Output format:

{
  "schedule": [
    {
      "start": "HH:MM",
      "end": "HH:MM",
      "title": "string",
      "type": "task|break|idle"
    }
  ]
}
"""

    payload = {
        "burnout": burnout,
        "tasks": data["tasks"],
        "free_blocks": free_blocks,
        "calendar": events
    }

    raw = groq_call(payload, system_prompt)
    plan = extract_json(raw)

    if not plan:
        plan = {"schedule": []}

    state_memory["burnout_history"].append(burnout)

    return {
        "burnout": round(burnout, 2),
        "free_blocks": free_blocks,
        "plan": plan
    }

# =========================================================
# ICS EXPORT (GOOGLE CALENDAR IMPORT FILE)
# =========================================================
def export_ics(schedule, filename="generated_schedule.ics"):

    now = datetime(2026, 4, 25, 6, 0, 0)  # fixed base day for consistency

    lines = [
        "BEGIN:VCALENDAR",
        "VERSION:2.0",
        "PRODID:-//BurnoutOptimizer//EN"
    ]

    for i, item in enumerate(schedule):

        try:
            sh, sm = map(int, item["start"].split(":"))
            eh, em = map(int, item["end"].split(":"))

            start_dt = now.replace(hour=sh, minute=sm)
            end_dt = now.replace(hour=eh, minute=em)

            lines += [
                "BEGIN:VEVENT",
                f"UID:{i}@burnout",
                f"DTSTART:{start_dt.strftime('%Y%m%dT%H%M%S')}",
                f"DTEND:{end_dt.strftime('%Y%m%dT%H%M%S')}",
                f"SUMMARY:{item.get('title','Task')}",
                "END:VEVENT"
            ]
        except:
            continue

    lines.append("END:VCALENDAR")

    with open(filename, "w") as f:
        f.write("\n".join(lines))

    return filename

