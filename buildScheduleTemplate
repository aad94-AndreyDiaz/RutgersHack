# =========================================================
# TIME HELPERS
# =========================================================
def to_min(t):
    h,m = map(int,t.split(":"))
    return h*60+m

def to_time(m):
    return f"{m//60:02d}:{m%60:02d}"

# =========================================================
# FREE BLOCK GENERATION (CRITICAL FIX)
# =========================================================
def compute_free_blocks(events):
    events = sorted(events, key=lambda x: to_min(x["start"]))
    start_day, end_day = 6*60, 23*60

    free = []
    cur = start_day

    for e in events:
        s, t = to_min(e["start"]), to_min(e["end"])
        if s > cur:
            free.append((cur, s))
        cur = max(cur, t)

    if cur < end_day:
        free.append((cur, end_day))

    return free

